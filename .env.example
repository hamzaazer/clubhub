# Copy to .env for local use (never commit .env)
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Leave empty locally to use SQLite. For Supabase, use the Session pooler URL
# from Dashboard > Connect (port 5432) as DATABASE_URL.
DATABASE_URL=
# Optional: used only by scripts/migrate_sqlite_to_supabase.py
SUPABASE_DATABASE_URL=
# Set true on Supabase if the app should enable RLS on its public tables.
SUPABASE_ENABLE_RLS=false
# The first Owner account is created automatically on startup if none exists
OWNER_NAME=Club Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=choose-a-strong-password
